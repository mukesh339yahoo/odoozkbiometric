<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Raw Attendance Logs -->
        <record id="seq_zk_attendance_log" model="ir.sequence">
            <field name="name">Biometric Attendance Log Sequence</field>
            <field name="code">zk.attendance.log</field>
            <field name="prefix">BIO/%(year)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Biometric Device Code -->
        <record id="seq_zk_machine" model="ir.sequence">
            <field name="name">Biometric Device Code Sequence</field>
            <field name="code">zk.machine</field>
            <field name="prefix">DEV/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
