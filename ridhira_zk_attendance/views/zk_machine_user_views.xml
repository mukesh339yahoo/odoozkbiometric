<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_zk_machine_user_list" model="ir.ui.view">
        <field name="name">zk.machine.user.list</field>
        <field name="model">zk.machine.user</field>
        <field name="arch" type="xml">
            <list string="Biometric Enrolled Users" editable="bottom">
                <field name="device_user_id"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="device_id"/>
                <field name="badge_number"/>
                <field name="privilege" widget="badge"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="last_sync" readonly="1"/>
                <button name="action_upload_to_device" string="Upload" type="object" icon="fa-upload" title="Upload to device"/>
                <button name="action_delete_from_device" string="Delete" type="object" icon="fa-trash" title="Delete from device" confirm="Are you sure you want to remove this user from the physical device?"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_zk_machine_user_form" model="ir.ui.view">
        <field name="name">zk.machine.user.form</field>
        <field name="model">zk.machine.user</field>
        <field name="arch" type="xml">
            <form string="Biometric Device User">
                <header>
                    <button name="action_upload_to_device" string="Upload to Device" type="object" class="oe_highlight btn-primary" icon="fa-upload"/>
                    <button name="action_delete_from_device" string="Delete from Device" type="object" class="btn-danger" icon="fa-trash" confirm="Are you sure?"/>
                </header>
                <sheet>
                    <group>
                        <group string="Device Profile">
                            <field name="device_user_id"/>
                            <field name="name"/>
                            <field name="device_id"/>
                            <field name="badge_number"/>
                        </group>
                        <group string="System Association">
                            <field name="employee_id"/>
                            <field name="privilege"/>
                            <field name="enabled"/>
                            <field name="last_sync"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_zk_machine_user_search" model="ir.ui.view">
        <field name="name">zk.machine.user.search</field>
        <field name="model">zk.machine.user</field>
        <field name="arch" type="xml">
            <search string="Search Enrolled Users">
                <field name="name"/>
                <field name="device_user_id"/>
                <field name="employee_id"/>
                <field name="device_id"/>
                <field name="badge_number"/>
                <filter string="Unmapped Employees" name="unmapped" domain="[('employee_id', '=', False)]"/>
                <filter string="Administrators" name="admins" domain="[('privilege', '!=', '0')]"/>
                <group expand="0" string="Group By">
                    <filter string="Biometric Device" name="group_by_device" context="{'group_by': 'device_id'}"/>
                    <filter string="Odoo Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Privilege" name="group_by_privilege" context="{'group_by': 'privilege'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_zk_machine_user" model="ir.actions.act_window">
        <field name="name">Device User Mappings</field>
        <field name="res_model">zk.machine.user</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zk_machine_user_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No biometric user mappings enrolled.
            </p>
            <p>
                Download users from your devices or enroll Odoo employees directly to biometric terminals.
            </p>
        </field>
    </record>
</odoo>
